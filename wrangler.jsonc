{
  "name": "starbrowse-ai-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  
  // 关闭 workers.dev 子域名
  "workers_dev": false,
  
  // 关闭预览 URL
  "preview_urls": false,
  
  // 自定义路由
  "routes": [
    {
      "pattern": "starbrowser-ai.zztxer.dpdns.org",
      "zone_name": "zztxer.dpdns.org"
    }
  ],
  
  // AI 绑定
  "ai": {
    "binding": "AI"
  }
}